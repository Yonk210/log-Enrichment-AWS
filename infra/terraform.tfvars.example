# ==============================================================
# terraform.tfvars.example
# ==============================================================
# Usage instructions:
# 1. Copy this file and rename it to: terraform.tfvars
# 2. Fill in the relevant values for your environment
# * The actual terraform.tfvars file is ignored and won't be committed.
# ==============================================================

# The AWS region where all resources will be provisioned
aws_region   = "us-east-1"

# Prefix applied to every resource name for namespacing (lowercase, numbers, and hyphens only)
project_name = "log-enricher"

# List of VPC IDs to enable Flow Logs on (leave empty to target all VPCs automatically)
# vpc_ids     = ["vpc-12345678", "vpc-87654321"]

# Primary SIEM destination for the Firehose stream. One of: s3, datadog, splunk
siem_destination_type = "s3"

# Datadog settings (Required only if siem_destination_type is "datadog")
# datadog_api_key     = "your-datadog-api-key"

# Splunk HEC settings (Required only if siem_destination_type is "splunk")
# splunk_hec_endpoint = "https://http-inputs-myorg.splunkcloud.com"
# splunk_hec_token    = "your-splunk-hec-token"

# Map of tags to apply to all provisioned AWS resources
tags = {
  Environment = "development"
  Project     = "log-enrichment"
  ManagedBy   = "terraform"
}
